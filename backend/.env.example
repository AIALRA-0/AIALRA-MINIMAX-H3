# Local H3 appliance profile
AIALRA_LOCAL_ONLY=1
AIALRA_H3_APPLIANCE=1
AIALRA_LOCKED_MODE=0
AIALRA_DATA_ROOT=D:/AIALRA-MINIMAX-H3/outputs/studio
AIALRA_JOB_DB=D:/AIALRA-MINIMAX-H3/outputs/studio/jobs.sqlite3
AIALRA_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ComfyUI stays bound to loopback. The frontend talks to this backend only
COMFY_URL=http://127.0.0.1:8188
COMFY_DIR=D:/AIALRA-MINIMAX-H3/ComfyUI
COMFY_MODELS_DIR=D:/AIALRA-MINIMAX-H3/models
COMFY_OUTPUT_DIR=D:/AIALRA-MINIMAX-H3/outputs/comfyui
COMFY_LORAS_DIR=D:/AIALRA-MINIMAX-H3/models/loras

# Add these only if you intentionally enable a hybrid cloud profile
# FAL_KEY=
# REPLICATE_API_TOKEN=
